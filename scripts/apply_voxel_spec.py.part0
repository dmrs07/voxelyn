#!/usr/bin/env python3
from pathlib import Path
import base64
import json

ROOT = Path(__file__).resolve().parents[1]
import io
import tarfile

BUNDLE = ''.join(Path(__file__).with_name(f'voxel_bundle.part{i}').read_text() for i in range(6))
with tarfile.open(fileobj=io.BytesIO(base64.b64decode(BUNDLE)), mode='r:gz') as archive:
    archive.extractall(ROOT)
    for member in archive.getmembers():
        if member.isfile():
            print('wrote', member.name)

def patch(path: str, old: str, new: str, count: int = 1) -> None:
    target = ROOT / path
    text = target.read_text()
    actual = text.count(old)
    if actual < count:
        raise RuntimeError(f'{path}: expected at least {count} occurrences, found {actual}: {old[:100]!r}')
    target.write_text(text.replace(old, new, count))
    print('patched', path)

