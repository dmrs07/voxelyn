{
  "name": "@voxelyn/survival-server",
  "version": "0.1.0",
  "private": true,
  "description": "Voxelyn Survival - authoritative co-op server (rooms, chunk sync, reconnect, resync)",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "voxelyn-survival-server": "./dist/bin/serve.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/bin/serve.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@voxelyn/survival-protocol": "workspace:*",
    "@voxelyn/survival-sim": "workspace:*",
    "ws": "^8.18.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4",
    "@types/pg": "^8.11.10"
  }
}
