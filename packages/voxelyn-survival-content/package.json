{
  "name": "@voxelyn/survival-content",
  "version": "0.1.0",
  "private": true,
  "description": "Voxelyn Survival - sprite manifests, generated atlases and the asset pipeline",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "node tools/generate.mjs",
    "validate": "node tools/validate.mjs",
    "test": "node tools/validate.mjs && vitest run",
    "render:splash": "node tools/splash/render-splash.mjs",
    "render:splash:all": "node tools/splash/render-all.mjs",
    "splash:frame": "node tools/splash/frame.mjs",
    "splash:solve": "node tools/splash/solve-frame.mjs"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@voxelyn/core": "workspace:*",
    "@voxelyn/survival-sim": "workspace:*"
  }
}
