{
  "name": "@voxelyn/survival-content",
  "version": "0.1.0",
  "private": true,
  "description": "Voxelyn Survival - sprite manifests, generated atlases and the asset pipeline",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "node tools/generate.mjs",
    "validate": "node tools/validate.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
