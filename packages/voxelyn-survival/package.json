{
  "name": "@voxelyn/survival",
  "version": "0.1.0",
  "private": true,
  "description": "Voxelyn Survival - real-time action survival roguelike (vertical slice)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "build:offline-check": "vite build && node scripts/check-precache.mjs",
    "check:audio": "node scripts/check-audio.mjs",
    "check:minigun": "node scripts/check-minigun.mjs",
    "soundtrack:prepare": "node scripts/prepare-soundtrack.mjs"
  },
  "dependencies": {
    "@voxelyn/survival-content": "workspace:*",
    "@voxelyn/survival-protocol": "workspace:*",
    "@voxelyn/survival-sim": "workspace:*"
  },
  "devDependencies": {
    "@voxelyn/survival-server": "workspace:*",
    "happy-dom": "^20.11.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
