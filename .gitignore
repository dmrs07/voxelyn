# Dependencies
node_modules/

# Build output
dist/
build/
out/

# Zips de release do Survival (o dist/ empacotado para upload no itch.io).
# Mesmo motivo do dist/: e artefato gerado, reproduzivel por `pnpm --filter
# @voxelyn/survival build`, e alguns megabytes de binario que ficariam no
# historico para sempre.
voxelyn-survival-*.zip

# TypeScript cache
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Coverage
coverage/

# Cache
.cache/
.parcel-cache/

